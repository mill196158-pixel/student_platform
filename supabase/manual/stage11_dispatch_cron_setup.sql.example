-- A) Exactly one cron job with this name:
-- select jobid, jobname, schedule, active
-- from cron.job
-- where jobname = 'dispatch-push-notifications-minutely';
-- -- expect: 1 row, active = true, schedule = '* * * * *'

-- B) Pending due rows exist / are claimable:
-- select id, status, attempts, available_at, processing_started_at, last_error
-- from public.notification_outbox
-- where status = 'pending'
--   and available_at <= now()
--   and attempts < 8
-- order by available_at
-- limit 20;

-- C) Stale processing (< 8 attempts) is reclaimable by claim:
-- select id, status, attempts, processing_started_at
-- from public.notification_outbox
-- where status = 'processing'
--   and attempts < 8
--   and processing_started_at is not null
--   and processing_started_at <= now() - interval '5 minutes';

-- D) Exhausted stale processing becomes failed on next claim:
